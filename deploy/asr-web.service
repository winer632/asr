[Unit]
Description=ASR continuous recording web application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=asr-web
Group=asr-web
WorkingDirectory=/srv/asr/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/asr/asr.env
ExecStart=/usr/bin/node --enable-source-maps dist/server/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
StateDirectory=asr
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/asr

[Install]
WantedBy=multi-user.target
