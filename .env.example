# SenseNova ASR 0930 hosted service. Use the intranet host when the machine is
# on the office network, the public one otherwise. /infer, /infer/stream and
# /health are appended to whatever path this base carries.
ASR_BASE_URL=https://api-gai-volc.sensetime.com/agent-5o/signpost/v0/prod-agent-5o-sensenova-filabs-asr-v1
# ASR_BASE_URL=https://api-gai-volc-internal.sensetime.com/agent-5o/signpost/v0/prod-agent-5o-sensenova-filabs-asr-v1
ASR_API_KEY=replace-with-your-api-key
# Required on both entry points. Apply for an authorised value from the
# SenseTime speech group. Never commit real keys or app IDs.
ASR_APP_ID=
# Upstream server VAD is recommended to prevent overlong utterances.
ASR_SERVER_VAD=1
# Server VAD silence threshold: 100–2000 ms, default 800.
ASR_VAD_INTERVAL_MS=800
# Default for clients that omit tradition; the webpage offers its own choice.
ASR_TRADITION=0
# Positive linear gain. Do not enable the documentation's TODO fields.
ASR_GAIN=1
VAD_MODEL_PATH=models/net.onnx
RECORDINGS_DIR=recordings
VAD_SILENCE_MS=600
# Cut an utterance that keeps running at its next detected pause. 0 disables it.
VAD_SOFT_SPLIT_SECONDS=12
VAD_SOFT_SPLIT_PAUSE_MS=200
# Recognise every finished segment again from its saved WAV: restores punctuation
# and recovers segments whose streaming session failed.
ASR_FILE_RECOGNITION=1
# Close a segment with a mark derived from the measured pause when the service
# returns no punctuation at all.
PAUSE_PUNCTUATION=1
ASR_CONCURRENCY=8
MAX_CONNECTIONS=8
HOST=127.0.0.1
PORT=5173
# External browser origin when HTTPS terminates at a reverse proxy:
# PUBLIC_ORIGIN=https://asr.office.example
# For phone access, bind to your LAN and provide a trusted HTTPS certificate:
# HOST=0.0.0.0
# TLS_KEY_FILE=certs/lan-key.pem
# TLS_CERT_FILE=certs/lan.pem
