ASR_BASE_URL=http://10.210.1.23:19003
ASR_API_KEY=replace-with-your-api-key
VAD_MODEL_PATH=models/net.onnx
RECORDINGS_DIR=recordings
VAD_SILENCE_MS=600
# Cut an utterance that keeps running at its next detected pause. 0 disables it.
VAD_SOFT_SPLIT_SECONDS=12
VAD_SOFT_SPLIT_PAUSE_MS=200
# Recognise every finished segment again from its saved WAV: restores punctuation
# and recovers segments whose streaming session failed.
ASR_FILE_RECOGNITION=1
# Close a segment with a mark derived from the measured pause when the service
# returns no punctuation at all.
PAUSE_PUNCTUATION=1
ASR_CONCURRENCY=8
MAX_CONNECTIONS=8
HOST=127.0.0.1
PORT=5173
# External browser origin when HTTPS terminates at a reverse proxy:
# PUBLIC_ORIGIN=https://asr.office.example
# For phone access, bind to your LAN and provide a trusted HTTPS certificate:
# HOST=0.0.0.0
# TLS_KEY_FILE=certs/lan-key.pem
# TLS_CERT_FILE=certs/lan.pem
